{
  "mcpServers": {
    "mathproven": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/mcp.mjs"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_MATHPROVEN_KEY": "${user_config.mathproven_key}"
      }
    },
    "mathproven-reference": {
      "type": "http",
      "url": "https://mathproven.com/api/agents/mcp"
    }
  }
}
